{
  "name": "mali-desktop",
  "productName": "Mali",
  "version": "1.0.0",
  "description": "มะลิ — แอปโซเชียล",
  "main": "main.js",
  "author": "Mali",
  "license": "MIT",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "devDependencies": { "electron": "45.2.1", "electron-builder": "26.18.0" },
  "build": {
    "appId": "app.mali.social",
    "productName": "Mali",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "package.json"],
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.social-networking", "icon": "build/icon.png" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64", "arm64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
    "artifactName": "Mali-${version}-${os}-${arch}.${ext}"
  }
}
